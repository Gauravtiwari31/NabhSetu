# Copy to .env. Never commit secrets.
#
# Mock (safe, default): docker compose up --build
# Live presentation:     docker compose -f docker-compose.yml -f docker-compose.live.yml up --build
# Then collect from the dashboard. Do not enable --profile live-schedule unless you
# intend a daily EaseMyTrip basket run.

APIX_APP_NAME=APIx Backend
APIX_ENVIRONMENT=development
APIX_LOG_LEVEL=INFO
APIX_DATA_MODE=live
APIX_EGRESS_MODE=direct

# Async SQLAlchemy URL. Docker Compose sets this automatically.
APIX_DATABASE_URL=postgresql+asyncpg://apix:apix@localhost:5432/apix

# Required for POST /collection-jobs, GET /sources, GET /fares, and /v1 NSO/RBI routes.
APIX_API_KEY=change-me-in-local-development
APIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional live scheduler allowlist (comma-separated source names).
# APIX_SCHEDULER_SOURCE_NAMES=EaseMyTrip

# Circuit breaker and compliance lease defaults (seconds / counts).
APIX_CIRCUIT_FAILURE_THRESHOLD=5
APIX_CIRCUIT_COOLDOWN_SECONDS=60
APIX_COMPLIANCE_LEASE_SECONDS=180
APIX_MAX_ADAPTER_RETRIES=0

# Identified research User-Agent. Do not spoof a consumer browser.
APIX_IDENTIFIED_USER_AGENT=APIx-Research-Bot/0.1 (+https://www.mospi.gov.in; SIH26056 airfare index research)
APIX_HTTP_TIMEOUT_SECONDS=45
APIX_PLAYWRIGHT_TIMEOUT_MS=60000
APIX_LIVE_PAYLOAD_MAX_BYTES=2097152
